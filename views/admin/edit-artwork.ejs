<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content admin-artworks-page">
  <div class="container admin-container" style="max-width: 900px;">
    <div class="admin-header-row">
      <div>
        <a href="/admin/artworks" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Gallery Artworks</a>
        <h1 class="admin-page-title"><i class="fa-solid fa-pen-to-square gold-text"></i> Edit Portrait Artwork</h1>
        <p class="admin-page-subtitle">Update artwork specifications, description, commission rate, or replace photograph.</p>
      </div>

      <a href="/#gallery" class="btn btn-outline-light btn-sm" target="_blank">
        <i class="fa-solid fa-eye"></i> View Live Gallery
      </a>
    </div>

    <%- include('../partials/alerts') %>

    <div class="admin-card" style="margin-top: 10px;">
      <form action="/admin/artworks/edit/<%= artwork._id %>" method="POST" enctype="multipart/form-data" class="admin-artwork-form">
        
        <!-- Artwork Title -->
        <div class="form-group">
          <label for="title" class="form-label">Artwork Title *</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            class="form-control" 
            value="<%= artwork.title %>" 
            required
          >
        </div>

        <!-- Category & Base Price -->
        <div class="form-row">
          <div class="form-group col-half">
            <label for="category" class="form-label">Category *</label>
            <select id="category" name="category" class="form-control" required>
              <option value="Hyper-Realistic" <%= artwork.category === 'Hyper-Realistic' ? 'selected' : '' %>>Hyper-Realistic</option>
              <option value="Couple & Wedding" <%= artwork.category === 'Couple & Wedding' ? 'selected' : '' %>>Couple & Wedding</option>
              <option value="Celebrity & Icons" <%= artwork.category === 'Celebrity & Icons' ? 'selected' : '' %>>Celebrity & Icons</option>
              <option value="Pet Portraits" <%= artwork.category === 'Pet Portraits' ? 'selected' : '' %>>Pet Portraits</option>
              <option value="Wildlife & Nature" <%= artwork.category === 'Wildlife & Nature' ? 'selected' : '' %>>Wildlife & Nature</option>
            </select>
          </div>

          <div class="form-group col-half">
            <label for="price" class="form-label">Commission Base Price (INR) *</label>
            <input 
              type="number" 
              id="price" 
              name="price" 
              class="form-control" 
              value="<%= artwork.price %>" 
              required
            >
          </div>
        </div>

        <!-- Medium & Size -->
        <div class="form-row">
          <div class="form-group col-half">
            <label for="medium" class="form-label">Medium Used</label>
            <input 
              type="text" 
              id="medium" 
              name="medium" 
              class="form-control" 
              value="<%= artwork.medium %>" 
              required
            >
          </div>

          <div class="form-group col-half">
            <label for="size" class="form-label">Paper Dimension</label>
            <select id="size" name="size" class="form-control">
              <option value="A4 (8.3 x 11.7 in)" <%= artwork.size && artwork.size.includes('A4') ? 'selected' : '' %>>A4 (8.3 x 11.7 in)</option>
              <option value="A3 (11.7 x 16.5 in)" <%= artwork.size && artwork.size.includes('A3') ? 'selected' : '' %>>A3 (11.7 x 16.5 in)</option>
              <option value="A2 (16.5 x 23.4 in)" <%= artwork.size && artwork.size.includes('A2') ? 'selected' : '' %>>A2 (16.5 x 23.4 in)</option>
            </select>
          </div>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label for="description" class="form-label">Artistic Description / Technique Notes</label>
          <textarea 
            id="description" 
            name="description" 
            rows="3" 
            class="form-control"
          ><%= artwork.description %></textarea>
        </div>

        <!-- Current Image & Replace Option -->
        <div class="form-group" style="background: var(--bg-surface); padding: 18px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); margin-bottom: 24px;">
          <label class="form-label"><i class="fa-solid fa-image gold-text"></i> Current Artwork Image</label>
          
          <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 14px;">
            <img 
              src="<%= artwork.image_url %>" 
              alt="<%= artwork.title %>" 
              id="currentArtPreview"
              style="width: 100px; height: 100px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-subtle);"
            >
            <div>
              <p style="font-size: 13px; color: #fff; margin-bottom: 4px;"><strong><%= artwork.title %></strong></p>
              <small class="text-dim" style="display: block; margin-bottom: 8px;">Path: <%= artwork.image_url %></small>
              <span class="badge-role-admin" style="font-size: 11px; padding: 3px 8px;">Active in Portfolio</span>
            </div>
          </div>

          <label for="artwork_image" class="form-label" style="font-size: 12px; color: var(--gold-light);">
            <i class="fa-solid fa-cloud-arrow-up"></i> Upload New Image to Replace (Leave blank to keep current)
          </label>
          <input 
            type="file" 
            id="artwork_image" 
            name="artwork_image" 
            class="form-control" 
            accept="image/*"
            onchange="previewNewImage(this)"
          >
          <small class="form-hint">Accepted formats: JPG, PNG, WEBP, AVIF (Max 20MB)</small>
        </div>

        <!-- Featured Checkbox -->
        <div class="form-group form-check" style="margin-bottom: 28px;">
          <label class="custom-checkbox" style="cursor: pointer; display: flex; align-items: center; gap: 10px;">
            <input 
              type="checkbox" 
              name="featured" 
              value="1" 
              <%= artwork.featured ? 'checked' : '' %>
              style="width: 18px; height: 18px; accent-color: var(--gold-primary);"
            >
            <span style="font-size: 14px; color: #fff;">Feature this portrait in Homepage Spotlight / Hero Showcase</span>
          </label>
        </div>

        <!-- Submit & Cancel Buttons -->
        <div style="display: flex; gap: 14px; align-items: center;">
          <button type="submit" class="btn btn-gold btn-lg" style="flex: 1;">
            <i class="fa-solid fa-check"></i> Save Artwork Changes
          </button>
          <a href="/admin/artworks" class="btn btn-secondary btn-lg" style="flex: 0.4; text-align: center;">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
function previewNewImage(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('currentArtPreview').src = e.target.result;
    }
    reader.readAsDataURL(input.files[0]);
  }
}
</script>

<%- include('../partials/footer') %>

