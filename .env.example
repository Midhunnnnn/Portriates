# Server Configuration
NODE_ENV=development
PORT=5000

# Database (local MongoDB for dev; set MongoDB Atlas URI in Vercel production)
MONGODB_URI=mongodb://127.0.0.1:27017/pencil_portraits_studio

# Session & Cookie Security
SESSION_SECRET=replace_with_a_strong_random_secret
# Optional overrides (defaults: secure=true & sameSite=none in production/Vercel, secure=false & sameSite=lax locally)
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# Production CORS (set deployed React frontend URL; comma-separated extras supported)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Nodemailer (Gmail SMTP App Password)
EMAIL_USER=your_studio_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Admin Account Defaults
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_DEFAULT_PASS=change_this_admin_password

# Optional Cloudinary (recommended for permanent image uploads on Vercel)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

